# Database Environment Variables
DATABASE_URL=jdbc:postgresql://localhost:5432/neurowikidb
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT Security Environment Variables
JWT_SECRET=neurowiki_super_secret_jwt_key_which_is_at_least_256_bits_long_for_hs256_security_token!
JWT_EXPIRATION=86400000

# AI & RAG Configuration Variables (GEMINI_API_KEY is standard, AI_API_KEY takes priority if set)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-flash-latest
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_MODEL=gemini-embedding-001
